{
  "name": "class-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ClassConnect (班級連) — parent–teacher communication platform. Production app upgraded from the interactive demo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run -c vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "test:visual": "echo \"[visual] Storybook/Chromatic not wired yet (P5)\" && exit 0",
    "storybook": "echo \"[storybook] not wired yet (P0/P1)\" && exit 0",
    "gen:types": "supabase gen types typescript --local > src/types/db.ts",
    "deploy:db": "npx supabase db push",
    "deploy:functions": "npx supabase functions deploy redeem_invite && npx supabase functions deploy send_push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "supabase": "^2.109.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.1",
    "web-push": "^3.6.7"
  },
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=18.18"
  }
}
