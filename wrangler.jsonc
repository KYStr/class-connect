{
  // Static SPA on Cloudflare Workers Assets (no Vite Cloudflare plugin needed).
  // Build first: npm run build — then: npm run deploy:web
  "name": "class-connect",
  "compatibility_date": "2025-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
